rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isHR() {
      return request.auth != null
        && (
          request.auth.token.hr == true
          || (
            request.auth.token.email != null
            && exists(/databases/$(database)/documents/staffRoles/$(request.auth.token.email))
          )
        );
    }

    function canReviewApplications() {
      return isAdmin() || isHR();
    }

    match /jobs/{jobId} {
      allow read: if isAdmin() || resource.data.isActive == true;
      allow create, update, delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow create: if request.resource.data.keys().hasOnly([
        'jobId', 'fullName', 'birthDate', 'email', 'phone', 'whatsappNumber',
        'address', 'bio', 'education', 'experience', 'privacyConsent',
        'dedupeKey', 'cvDelivery', 'cvReceived', 'status', 'submittedAt', 'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'jobId', 'fullName', 'birthDate', 'email', 'phone', 'whatsappNumber',
        'address', 'education', 'experience', 'privacyConsent', 'dedupeKey',
        'cvDelivery', 'cvReceived', 'status', 'submittedAt', 'updatedAt'
      ])
      && request.resource.data.status == 'pending'
      && request.resource.data.privacyConsent == true
      && request.resource.data.jobId is string
      && request.resource.data.jobId.size() > 0
      && request.resource.data.dedupeKey is string
      && request.resource.data.dedupeKey == applicationId
      && request.resource.data.dedupeKey.size() == 64
      && exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId))
      && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.isActive == true
      && request.resource.data.fullName is string
      && request.resource.data.fullName.size() >= 2
      && request.resource.data.fullName.size() <= 120
      && request.resource.data.birthDate is string
      && request.resource.data.birthDate.size() >= 4
      && request.resource.data.birthDate.size() <= 20
      && request.resource.data.email is string
      && request.resource.data.email.size() <= 254
      && request.resource.data.phone is string
      && request.resource.data.phone.size() >= 8
      && request.resource.data.phone.size() <= 30
      && request.resource.data.whatsappNumber is string
      && request.resource.data.whatsappNumber.size() >= 8
      && request.resource.data.whatsappNumber.size() <= 30
      && request.resource.data.address is string
      && request.resource.data.address.size() >= 2
      && request.resource.data.address.size() <= 300
      && request.resource.data.education is map
      && request.resource.data.education.keys().hasAll(['degree', 'institution', 'graduationYear'])
      && request.resource.data.education.keys().hasOnly(['degree', 'institution', 'graduationYear', 'grade'])
      && request.resource.data.education.degree is string
      && request.resource.data.education.degree.size() >= 2
      && request.resource.data.education.degree.size() <= 160
      && request.resource.data.education.institution is string
      && request.resource.data.education.institution.size() >= 2
      && request.resource.data.education.institution.size() <= 200
      && request.resource.data.education.graduationYear is number
      && (!request.resource.data.education.keys().hasAny(['grade'])
        || (request.resource.data.education.grade is string
          && request.resource.data.education.grade.size() <= 80))
      && request.resource.data.experience is map
      && request.resource.data.experience.keys().hasAll(['company', 'position', 'startDate'])
      && request.resource.data.experience.keys().hasOnly(['company', 'position', 'startDate', 'endDate', 'description'])
      && request.resource.data.experience.company is string
      && request.resource.data.experience.company.size() >= 2
      && request.resource.data.experience.company.size() <= 160
      && request.resource.data.experience.position is string
      && request.resource.data.experience.position.size() >= 2
      && request.resource.data.experience.position.size() <= 160
      && request.resource.data.experience.startDate is string
      && request.resource.data.experience.startDate.size() >= 1
      && (!request.resource.data.experience.keys().hasAny(['endDate'])
        || (request.resource.data.experience.endDate is string
          && request.resource.data.experience.endDate.size() <= 30))
      && (!request.resource.data.experience.keys().hasAny(['description'])
        || (request.resource.data.experience.description is string
          && request.resource.data.experience.description.size() <= 2000))
      && (!request.resource.data.keys().hasAny(['bio'])
        || (request.resource.data.bio is string
          && request.resource.data.bio.size() <= 2000))
      && request.resource.data.privacyConsent == true
      && request.resource.data.cvDelivery == 'whatsapp'
      && request.resource.data.cvReceived == false;

      allow read: if canReviewApplications();
      allow update: if canReviewApplications()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt'
        ])
        && request.resource.data.status in [
          'pending', 'reviewing', 'shortlisted', 'rejected', 'hired'
        ];
      allow delete: if isAdmin();
    }

    match /staffRoles/{email} {
      allow read: if isAdmin()
        || (
          request.auth != null
          && request.auth.token.email == email
        );
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if settingId in ['public', 'content'] || (settingId == 'googleSheets' && isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if canReviewApplications()
        && request.resource.data.keys().hasOnly([
          'action', 'entity', 'entityId', 'details', 'actorEmail', 'createdAt'
        ])
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.action is string
        && request.resource.data.entity is string
        && request.resource.data.entityId is string
        && request.resource.data.createdAt is string;
      allow update, delete: if false;
    }
  }
}
