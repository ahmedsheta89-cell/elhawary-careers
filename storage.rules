rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    match /cvs/{fileName} {
      allow read: if isAdmin(request.auth.uid);
      allow write: if request.auth == null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/(pdf|msword|.*officedocument.*wordprocessingml.*)');
      allow delete: if isAdmin(request.auth.uid);
    }
    
    match /{allPaths=**} {
      allow read, write: if isAdmin(request.auth.uid);
    }
    
    function isAdmin(uid) {
      return uid != null && 
        get(/databases/(default)/documents/admins/$(uid)).data.role in ['admin', 'manager'];
    }
  }
}
